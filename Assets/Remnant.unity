--- !u!114 &860002991
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 860002983}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c435ee88df405b4c856373e108a4149, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CountdownQuest
  timeLimit: 10
  targetItem: {fileID: 2096199956}
  npcObject: {fileID: 860002983}
  playerAnimator: {fileID: 2106734861}
  executionTrigger: Ketlieu
  timerText: {fileID: 1924938106}
  dialogueUI: {fileID: 186739513}
  leftDialogueBox: {fileID: 622370831}
  leftNameText: {fileID: 1724111340}
  leftDialogueText: {fileID: 914352274}
  rightDialogueBox: {fileID: 1725719751}
  rightNameText: {fileID: 596746463}
  rightDialogueText: {fileID: 1814070696}
  startLines:
  - speaker: ???
    isLeft: 0
    text: "\u201C(A roar echoes out of the darkness.)\u201D"
  - speaker: Hazel
    isLeft: 0
    text: 'I''m starving...

'
  - speaker: Hazel
    isLeft: 0
    text: 'Give me meat!

      

'
  - speaker: Nox
    isLeft: 1
    text: 'Calm down! I don''t want to fight!

'
  - speaker: Hazel
    isLeft: 0
    text: 'Then you''ll be my next meal!

'
  - speaker: Nox
    isLeft: 1
    text: 'Fine... I''ll find you something to eat.

'
  successLines:
  - speaker: Nox
    isLeft: 1
    text: "\u201C(Nox hands Hazel a piece of meat.)\u201D"
  - speaker: Nox
    isLeft: 0
    text: ' Here... Eat this.

'
  - speaker: Hazel
    isLeft: 0
    text: "\u201C(Hazel snatches the piece of meat and devours it greedily. After
      a few seconds, he gradually calms down.)\u201D"
  - speaker: Hazel
    isLeft: 0
    text: 'It''s been... so long since I last felt full...

'
  - speaker: Hazel
    isLeft: 0
    text: ' Perhaps... what I''ve longed for all this time... wasn''t just food'
  - speaker: Hazel
    isLeft: 0
    text: ' I only needed... someone willing to reach out, even to a monster like
      me.

'
  - speaker: Hazel
    isLeft: 0
    text: What's your name, little fox
  - speaker: Nox
    isLeft: 1
    text: It's Nox, Sir.
  - speaker: Hazel
    isLeft: 0
    text: 'Thank you, Nox. Because of you... I remembered who I used to be.

'
  - speaker: Hazel
    isLeft: 0
    text: 'Keep going. Someone is still waiting for you in the engine room. '
