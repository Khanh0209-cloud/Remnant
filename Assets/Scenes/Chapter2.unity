  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MotherNPC
  player: {fileID: 1506510444}
  keyFragment: {fileID: 792256963}
  firstMeetingLines:
  - isLeftSpeaker: 0
    speakerName: Chloe
    sentence: My son... Where are you...?
  - isLeftSpeaker: 1
    speakerName: Nox
    sentence: Are you alright?
  - isLeftSpeaker: 0
    speakerName: Chloe
    sentence: You can see me...? Please... Help me. I lost my son when the train
      crashed.
  - isLeftSpeaker: 1
    speakerName: Nox
    sentence: I'll find him.
  - isLeftSpeaker: 0
    speakerName: Chloe
    sentence: Just knowing he's safe... is enough.
  afterNecklacePart1Lines:
  - isLeftSpeaker: 1
    speakerName: Nox
    sentence: I found this necklace.
  - isLeftSpeaker: 0
    speakerName: Chloe
    sentence: This is... our picture...
  afterNecklacePart2Lines:
  - isLeftSpeaker: 1
    speakerName: Son
    sentence: Mom...
  - isLeftSpeaker: 0
    speakerName: Chloe
    sentence: "Oh, my dear\u2026 I'm so sorry... for making you wait so long."
  - isLeftSpeaker: 0
    speakerName: Chloe
    sentence: Thank you, Nox.
  anim: {fileID: 0}
  hugDuration: 4
  goneDuration: 7
  flipHugAnimationX: 1
  goneOffsetY: 0.3
