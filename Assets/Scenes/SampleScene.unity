--- !u!114 &394105314
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 394105313}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a22f0bfe14cfb964393a6e1c68baea28, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPC
  npcName: Mion
  dialoguePhase1:
  - speakerName: Nox
    text: W-What...? Who... who are you?
  - speakerName: 'Mion '
    text: 'Easy now, young one. If I meant you harm, you wouldn''t still be standing.

'
  - speakerName: Nox
    text: You're... a spirit?
  - speakerName: Mion
    text: "My name is Mion. \nMerely a passenger who never truly left this train."
  - speakerName: Nox
    text: "I'm looking for my older brother, Sion. \nHave you ever seen him?"
  - speakerName: 'Mion '
    text: "Hmm, I'm not sure. \nBut first of all\u2026 please help me find my golden
      pocket watch... the last gift my daughter ever gave me."
  dialoguePhase2:
  - speakerName: Nox
    text: Is this the watch you're looking for?
  - speakerName: Mion
    text: That's right... At last, I've found it again.
  - speakerName: Mion
    text: 'Thank you.

      I can finally move on.'
  - speakerName: Mion
    text: 'I hope you find the one you''re searching for.

'
  dialoguePanel: {fileID: 1449335621}
  dialogueText: {fileID: 1811035035}
  nameText: {fileID: 1877600118}
